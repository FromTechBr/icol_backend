@baseUrl = http://localhost:6060/api

### ========================================
### PHASE 1: Creation & Retrieval (POST & GET)
### ========================================

### --- INDEPENDENT ENTITIES ---

### 1.1 POST Valid Usuario (Expects 201)
POST {{baseUrl}}/usuarios
Content-Type: application/json

{
  "email": "email@gmail.com",
  "senha": "senhaSegura123",
  "tipoUsuario": "ALUNO"
}

### 1.2 POST Invalid Usuario (Expects 400)
POST {{baseUrl}}/usuarios
Content-Type: application/json

{
  "email": "" 
}

### 1.3 GET Existing Usuario (Expects 200)
GET {{baseUrl}}/usuarios/1

### 1.4 GET Non-Existing Usuario (Expects 404)
GET {{baseUrl}}/usuarios/9999


### 2.1 POST Valid Curso (Expects 201)
POST {{baseUrl}}/cursos
Content-Type: application/json

{
  "nomeCurso": "Introdução à Programação",
  "descricao": "Curso básico para iniciantes",
  "duracao": "40h",
  "categoria": "LIVRE"
}

### 2.2 POST Invalid Curso (Expects 400)
POST {{baseUrl}}/cursos
Content-Type: application/json

{
  "nomeCurso": ""
}

### 2.3 GET Existing Curso (Expects 200)
GET {{baseUrl}}/cursos/1

### 2.4 GET Non-Existing Curso (Expects 404)
GET {{baseUrl}}/cursos/9999


### --- LEVEL 1 DEPENDENCIES ---

### 3.1 POST Valid Docente (Expects 201)
POST {{baseUrl}}/docentes
Content-Type: application/json

{
  "usuarioId": 1,
  "nomeCompleto": "Carlos Andrade",
  "especializacao": "Engenharia de Software"
}

### 3.2 POST Invalid Docente (Expects 400)
POST {{baseUrl}}/docentes
Content-Type: application/json

{
  "usuarioId": null
}

### 3.3 GET Existing Docente (Expects 200)
GET {{baseUrl}}/docentes/1

### 3.4 GET Non-Existing Docente (Expects 404)
GET {{baseUrl}}/docentes/9999


### 4.1 POST Valid Aluno (Expects 201)
POST {{baseUrl}}/alunos
Content-Type: application/json

{
  "usuarioId": 1,
  "nomeCompleto": "João Silva",
  "idade": 25,
  "cpf": "12345678901",
  "telefone": "11999999999",
  "declaSocie": "Aprovada",
  "endereco": "Rua Teste, 123"
}

### 4.2 POST Invalid Aluno (Expects 400)
POST {{baseUrl}}/alunos
Content-Type: application/json

{
  "nomeCompleto": ""
}

### 4.3 GET Existing Aluno (Expects 200)
GET {{baseUrl}}/alunos/1

### 4.4 GET Non-Existing Aluno (Expects 404)
GET {{baseUrl}}/alunos/9999


### 5.1 POST Valid AvisoMural (Expects 201)
POST {{baseUrl}}/avisos
Content-Type: application/json

{
  "autorId": 1,
  "titulo": "Aviso Importante: Feriado",
  "conteudo": "Não haverá aula na próxima sexta-feira."
}

### 5.2 POST Invalid AvisoMural (Expects 400)
POST {{baseUrl}}/avisos
Content-Type: application/json

{
  "titulo": ""
}

### 5.3 GET Existing AvisoMural (Expects 200)
GET {{baseUrl}}/avisos/1

### 5.4 GET Non-Existing AvisoMural (Expects 404)
GET {{baseUrl}}/avisos/9999


### --- LEVEL 2 DEPENDENCIES ---

### 6.1 POST Valid Turma (Expects 201)
POST {{baseUrl}}/turmas
Content-Type: application/json

{
  "cursoId": 1,
  "docenteId": 1,
  "numMaxAlunos": 30,
  "statusTurma": "ABERTA",
  "cronogramaHorarios": "Seg e Qua - 19h às 21h"
}

### 6.2 POST Invalid Turma (Expects 400)
POST {{baseUrl}}/turmas
Content-Type: application/json

{
  "numMaxAlunos": -5
}

### 6.3 GET Existing Turma (Expects 200)
GET {{baseUrl}}/turmas/1

### 6.4 GET Non-Existing Turma (Expects 404)
GET {{baseUrl}}/turmas/9999


### --- LEVEL 3 DEPENDENCIES ---

### 7.1 POST Valid Matricula (Expects 201)
